# Evidence receiver webhook. Set in Vercel for Production (and Preview if you
# want previews to send). Leave unset locally: the quiz still returns the
# score and simply skips the webhook.
VYNTAR_EVIDENCE_WEBHOOK_URL=
VYNTAR_INGRESS_KEY=

# Optional. Both default to the existing public Supabase values in code;
# set them only to rotate without a code change.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
